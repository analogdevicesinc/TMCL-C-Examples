void setup() {

  pinMode(LED, OUTPUT);
  digitalWrite(LED, LOW);
  Serial.begin(9600);

  if (activeBus == TMC9660_BUS_UART) {
    setChipAddresses(DEFAULT_IC, 1, 255);
    Serial3.begin(115200);
    delay(10);

    pinMode(PIN_SPI_MOSI, OUTPUT);
    pinMode(PIN_SPI_SCK, OUTPUT);
    pinMode(PIN_SPI_SS, OUTPUT);
    digitalWrite(PIN_SPI_MOSI, LOW);
    digitalWrite(PIN_SPI_SS, LOW);
    digitalWrite(PIN_SPI_SCK, LOW);
    pinMode(HOLDN_FLASH, OUTPUT);
    digitalWrite(HOLDN_FLASH, HIGH);
  }

  pinMode(RESET_CTRL, OUTPUT);
  digitalWrite(RESET_CTRL, HIGH);
  delay(10);

  digitalWrite(RESET_CTRL, LOW);

  delay(1000);
  if (activeBus == TMC9660_BUS_UART) {
    Serial.println("\nBootstrapping started...");
    bootstrapping();
    Serial.println("Bootstrapping finished and App started!");
    delay(10);
  }
}

void loop() {
  String inputString = "";
  if (Serial.available()) {
    inputString = Serial.readStringUntil('\n');
    if (inputString == "1") {
      uint32_t val = 0;
      int32_t status = tmc9660_param_sendCommand(DEFAULT_IC, 136, 1, 0, 0, &val);
      if(status == 100){
      Serial.print("Module ID: ");
      Serial.println((val >> 16) & 0xFF);
      }
      else{
        Serial.println("Something went wrong!");
        Serial.print("Status: ");
        Serial.println(status);
      }
    } else if (inputString == "2") {
      rotateMotorOpenLoop(60000);
    }
  }
}
